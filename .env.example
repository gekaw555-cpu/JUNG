# Copiez ce fichier en .env et renseignez votre clé.
# Ne committez jamais le fichier .env réel (il est dans .gitignore).

ANTHROPIC_API_KEY=sk-ant-votre-cle-ici
ANTHROPIC_MODEL=claude-sonnet-5
PORT=3000

# Code d'accès partagé — à définir avant tout déploiement public pour éviter
# que n'importe qui puisse consommer votre crédit API. Laissez vide en local
# si vous ne voulez pas avoir à le taper à chaque fois.
ACCESS_CODE=
